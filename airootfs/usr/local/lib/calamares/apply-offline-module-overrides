#!/usr/bin/env bash
set -Eeuo pipefail

readonly SOURCE_DIR="/etc/calamares/offline-modules"
readonly TARGET_DIR="/etc/calamares/modules"

if [[ ! -d "$SOURCE_DIR" ]]; then
    printf 'Calamares offline override directory is absent: %s\n' \
        "$SOURCE_DIR" >&2
    exit 1
fi

mkdir -p "$TARGET_DIR"

found=0

while IFS= read -r -d '' source; do
    filename="$(basename "$source")"
    target="$TARGET_DIR/$filename"

    install \
        -o root \
        -g root \
        -m 0644 \
        "$source" \
        "$target"

    printf 'Installed Calamares override: %s\n' "$target"
    found=1
done < <(
    find "$SOURCE_DIR" \
        -maxdepth 1 \
        -type f \
        -name '*.conf' \
        -print0 \
        | sort -z
)

if (( found == 0 )); then
    printf 'No *.conf files found in: %s\n' "$SOURCE_DIR" >&2
    exit 1
fi
